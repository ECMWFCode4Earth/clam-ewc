#!/bin/bash

set -ex

date

WRF=_WRF_
RUN_DIR=_RUN_DIR_
cd $RUN_DIR

INPUT_DATA=$WRF/WRF/run
MAIN=$WRF/WRF/main

ENV_FILE="$WRF/arw_intel_env.sh"
source "$ENV_FILE"

ln -sf $INPUT_DATA/* .
rm -f rsl.error.* rsl.out.*

# --remove-destination: $INPUT_DATA/* linked a namelist.input symlink pointing
# into the read-only image; unlink it so a real file lands in the run dir.
cp --remove-destination namelist.input.clam namelist.input

REAL_NP="${REAL_NP:-4}"

ulimit -s unlimited
export OMP_NUM_THREADS=1
export OMP_STACKSIZE=512M
export KMP_STACKSIZE=512M

echo
echo "CPU information:"
echo "nproc = $(nproc)"
lscpu | grep -E '^CPU\(s\)|Thread|Core|Socket|NUMA' || true

mpirun -np "$REAL_NP" $MAIN/real.exe

# Multi-node orchestration (container/run_multinode.sh) sets this to stop after
# real.exe; the host launcher then runs wrf.exe across nodes.
if [ "${MULTINODE_HOST_WRF:-0}" = "1" ]; then
  echo "$0: real.exe done; skipping in-container wrf (host runs multi-node wrf)."
  exit 0
fi

bash run_wrf.sh
#bash run_wrf_multiVMs.sh

echo "$0 done."
